{
  "project": {
    "name": "AutoReview System",
    "version": "0.1.0",
    "description": "Sistema de automação para revisão sistemática assistida por IA"
  },
  "workflow": {
    "mode": "complex-system",
    "phases": [
      "research",
      "requirements", 
      "architecture",
      "frontend-design",
      "backend-phase",
      "ml-ai-integration",
      "integration-testing"
    ]
  },
  "integrations": {
    "coding-agent": "copilot",
    "ide": "vscode",
    "ui-framework": "streamlit"
  },
  "domain": {
    "area": "data-ml-ai",
    "focus": "academic-research-tools",
    "complexity": "system-complex"
  },
  "agents": {
    "framework": "crewai",
    "roles": [
      "Searcher Agent",
      "Triage Specialist", 
      "Data Extractor",
      "Review Coordinator"
    ]
  },
  "milestones": [
    {
      "name": "M1 - Core Research Tools",
      "duration": "2-3 meses",
      "goals": ["PDF extraction engine", "Database connectors", "Basic CLI interface"]
    },
    {
      "name": "M2 - AI-Assisted Triage", 
      "duration": "2-3 meses",
      "goals": ["ML classification models", "Semi-supervised learning pipeline", "Web UI for triage"]
    },
    {
      "name": "M3 - Integration & Polish",
      "duration": "1-2 meses", 
      "goals": ["Obsidian/Notion sync", "Collaborative features", "Performance optimization"]
    }
  ],
  "success-metrics": {
    "time-reduction-target": "70%",
    "classification-accuracy": ">85%",
    "metadata-completeness": ">90%"
  }
}
